          "name": "activities_sport_type_check",
          "value": "\"activities\".\"sport_type\" in ('football', 'basketball', 'tennis', 'padel', 'badminton', 'volleyball', 'running', 'cycling', 'swimming', 'climbing', 'fitness', 'petanque', 'hiking', 'table_tennis', 'handball', 'rugby', 'yoga', 'other')"
        },
        "activities_required_level_check": {
