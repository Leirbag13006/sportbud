          "value": "\"activities\".\"lng\" between -180 and 180"
        },
        "activities_duration_range": {
          "name": "activities_duration_range",
          "value": "\"activities\".\"duration_minutes\" between 15 and 720"
        },
        "activities_spots_total_range": {
          "name": "activities_spots_total_range",
          "value": "\"activities\".\"spots_total\" between 1 and 50"
        },
        "activities_spots_available_range": {
          "name": "activities_spots_available_range",
          "value": "\"activities\".\"spots_available\" between 0 and \"activities\".\"spots_total\""
        },
        "activities_status_matches_spots": {
          "name": "activities_status_matches_spots",
          "value": "\"activities\".\"status\" = 'cancelled' or (\"activities\".\"status\" = 'full') = (\"activities\".\"spots_available\" = 0)"
        },
        "activities_description_length": {
          "name": "activities_description_length",
          "value": "\"activities\".\"description\" is null or length(\"activities\".\"description\") <= 500"
        }
      }
