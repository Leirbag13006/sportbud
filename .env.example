# Aucune variable n'est nécessaire en local : la base est le fichier SQLite ./local.db.
#
# Pour une mise en ligne (ex. Vercel), utiliser une base Turso (SQLite hébergé) :
# copier ce fichier en .env.local et renseigner les valeurs ci-dessous.
# DATABASE_URL=libsql://sportbud-xxxx.turso.io
# DATABASE_AUTH_TOKEN=xxxxxxxx

# E-mails (lien « mot de passe oublié »). Sans ces variables, le lien est écrit dans les logs du serveur.
# Exemple avec Gmail : activer la validation en 2 étapes, puis créer un « mot de passe d'application ».
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ton.adresse@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM="SportMates <ton.adresse@gmail.com>"

# Modération : adresses e-mail des comptes ayant accès à /admin (séparées par des virgules)
# ADMIN_EMAILS=toi@exemple.fr
