# Copier ce fichier en .env.local puis renseigner les valeurs
# (Supabase → Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique : "Publishable key" (sb_publishable_…) ou ancienne clé "anon".
# Elle est conçue pour être exposée au navigateur : la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
